generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id      String @id
  nome    String
  apelido String
  numero  Int
  posicao String
  votos   Int    @default(0)
  // id do Team dono desse jogador ("gremio" = nosso elenco, votável;
  // qualquer outro = elenco de adversário, cacheado da football-data.org
  // sob demanda em /api/squad, sem votos.
  time    String @default("gremio")
}

model Round {
  id         String   @id
  numero     Int      @unique
  adversario String
  mando      String
  campeonato String
  abre       DateTime
  fecha      DateTime
  votantes   Int      @default(0)
  escalacao  String[] @default([])
  votosCasa  Int      @default(0)
  votosFora  Int      @default(0)
  // escalação final revelada do adversário quando a rodada encerra: array
  // de 11 { numero, nome }, na mesma ordem de SLOTS (lib/store.js). Guarda
  // nome/número direto (não um id de Player) porque o elenco do adversário
  // vem de fora (football-data.org) e não temos uma "escalação oficial"
  // real pra sincronizar — é só o resultado do palpite da torcida.
  escalacaoAdversario Json @default("[]")
}

// Escudos reais dos clubes, sincronizados via football-data.org
// (scripts/sync-jogos.js). id = nome normalizado (sem acento/sufixo).
model Team {
  id     String @id
  nome   String
  escudo String
  // id numérico do time na football-data.org, usado pra buscar o elenco
  // (endpoint /teams/{apiId}) em /api/squad.
  apiId  Int?   @unique
}

// Jogos reais dos principais campeonatos, mesma fonte.
model Match {
  id              Int      @id
  competition     String
  competitionCode String
  matchday        Int?
  utcDate         DateTime
  status          String
  homeTeam        String
  homeCrest       String
  awayTeam        String
  awayCrest       String
  homeScore       Int?
  awayScore       Int?

  @@index([utcDate])
  @@index([competitionCode])
}
