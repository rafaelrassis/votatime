generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id      String @id
  nome    String
  apelido String
  numero  Int
  posicao String
  votos   Int    @default(0)
}

model Round {
  id         String   @id
  numero     Int      @unique
  adversario String
  mando      String
  campeonato String
  abre       DateTime
  fecha      DateTime
  votantes   Int      @default(0)
  escalacao  String[] @default([])
}
